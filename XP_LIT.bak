{
  "version": 8,
  "name": "XP_LIT",
  "metadata": {
    "nightlighting for xp12": [
      {"key": "terrain", "variants": [{"id": "3d_terrain"}]}
    ],
    "version": "4.0.0-alpha.1",
    "maputnik:renderer": "mlgljs"
  },
  "center": [-0.0005, 51.4768],
  "zoom": 15,
  "light": {"anchor": "viewport", "intensity": 0.3, "position": [1.5, 235, 30]},
  "sky": {
    "sky-color": "hsl(208, 90%, 72%)",
    "sky-horizon-blend": 0.2,
    "horizon-color": "hsl(0, 0%, 100%)",
    "horizon-fog-blend": 0.9,
    "fog-color": "hsla(0, 0%, 100%, 0.2)",
    "fog-ground-blend": 0.8,
    "atmosphere-blend": 0.2
  },
  "projection": {"type": "mercator"},
  "sources": {
    "OFM": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"},
    "ArcGIS": {
      "type": "raster",
      "tiles": [
        "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "maxzoom": 16
    }
  },
  "layers": [
    {
      "id": "Background",
      "type": "background",
      "layout": {"visibility": "visible"},
      "paint": {"background-color": "rgba(0, 0, 0, 1)"}
    },
    {
      "id": "glow12 residential",
      "type": "circle",
      "source": "OFM",
      "source-layer": "landuse",
      "minzoom": 12,
      "maxzoom": 17,
      "filter": ["in", ["get", "class"], ["literal", ["residential"]]],
      "layout": {"visibility": "visible"},
      "paint": {
        "circle-color": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          12,
          "rgb(66, 31, 8)",
          16,
          "rgb(23, 19, 15)"
        ],
        "circle-radius": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          12,
          10.4,
          16,
          40
        ],
        "circle-blur": ["interpolate", ["linear"], ["zoom"], 12, 2, 16, 1],
        "circle-opacity": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          14,
          0.05,
          16,
          0.3
        ]
      }
    },
